    </div>

    @script
        <script>
            (() => {
                const libraryUrl =
                    'https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js';

                let scanner = null;
                let cameras = [];
                let cameraIndex = 0;
                let running = false;
                let processing = false;
                let lastDecodedText = null;
                let lastDecodedAt = 0;
                let overlayTimer = null;
                let audioContext = null;

                const getElement = (id) =>
                    document.getElementById(id);

                const startButton = getElement('elive-start-camera');
                const stopButton = getElement('elive-stop-camera');
                const switchButton = getElement('elive-switch-camera');
                const statusElement = getElement('elive-camera-status');
                const readerElement = getElement('elive-qr-reader');
                const overlayElement = getElement('elive-scan-overlay');
                const overlayIcon = getElement('elive-scan-overlay-icon');
                const overlayTitle = getElement('elive-scan-overlay-title');
                const overlayMessage = getElement('elive-scan-overlay-message');
                const overlayName = getElement('elive-scan-overlay-name');
                const overlayMeta = getElement('elive-scan-overlay-meta');
                const overlayCloseButton = getElement(
                    'elive-scan-overlay-close'
                );


                const getAudioContext = () => {
                    if (! audioContext) {
                        const AudioContextClass =
                            window.AudioContext
                            || window.webkitAudioContext;

                        if (AudioContextClass) {
                            audioContext = new AudioContextClass();
                        }
                    }

                    return audioContext;
                };

                const playTone = async (type) => {
                    const context = getAudioContext();

                    if (! context) {
                        return;
                    }

                    if (context.state === 'suspended') {
                        await context.resume();
                    }

                    const patterns = {
                        success: [
                            [740, 0, 0.11],
                            [980, 0.13, 0.16],
                        ],
                        warning: [
                            [520, 0, 0.16],
                            [420, 0.19, 0.2],
                        ],
                        error: [
                            [250, 0, 0.22],
                            [190, 0.24, 0.25],
                        ],
                    };

                    const pattern = patterns[type] ?? patterns.error;
                    const startAt = context.currentTime;

                    pattern.forEach(([frequency, offset, duration]) => {
                        const oscillator = context.createOscillator();
                        const gain = context.createGain();

                        oscillator.type = 'sine';
                        oscillator.frequency.value = frequency;

                        gain.gain.setValueAtTime(
                            0.0001,
                            startAt + offset
                        );
                        gain.gain.exponentialRampToValueAtTime(
                            0.18,
                            startAt + offset + 0.01
                        );
                        gain.gain.exponentialRampToValueAtTime(
                            0.0001,
                            startAt + offset + duration
                        );

                        oscillator.connect(gain);
                        gain.connect(context.destination);

                        oscillator.start(startAt + offset);
                        oscillator.stop(startAt + offset + duration + 0.03);
                    });
                };

                const closeResultOverlay = () => {
                    if (overlayTimer) {
                        window.clearTimeout(overlayTimer);
                        overlayTimer = null;
                    }

                    if (overlayElement) {
                        overlayElement.dataset.open = 'false';
                    }
                };

                const showResultOverlay = (result = {}) => {
                    if (! overlayElement) {
                        return;
                    }

                    const status = String(
                        result.status ?? 'check_in_failed'
                    );

                    let visualStatus = 'error';
                    let icon = '✕';

                    if (
                        status === 'checked_in'
                        || status === 'onsite_registered'
                        || result.success === true
                    ) {
                        visualStatus = 'success';
                        icon = '✓';
                    } else if (status === 'already_checked_in') {
                        visualStatus = 'warning';
                        icon = '!';
                    }

                    overlayElement.dataset.status = visualStatus;
                    overlayElement.dataset.open = 'true';

                    if (overlayIcon) {
                        overlayIcon.textContent = icon;
                    }

                    if (overlayTitle) {
                        overlayTitle.textContent =
                            result.title
                            ?? (
                                visualStatus === 'success'
                                    ? 'Check-in successful'
                                    : visualStatus === 'warning'
                                        ? 'Already checked in'
                                        : 'Check-in failed'
                            );
                    }

                    if (overlayMessage) {
                        overlayMessage.textContent =
                            result.message ?? '';
                    }

                    const attendee = result.attendee ?? {};

                    if (overlayName) {
                        overlayName.textContent =
                            attendee.name ?? '';
                    }

                    if (overlayMeta) {
                        const parts = [
                            attendee.badge_number,
                            result.check_in_point,
                        ].filter(Boolean);

                        overlayMeta.textContent = parts.join(' · ');
                    }

                    void playTone(visualStatus);

                    if (navigator.vibrate) {
                        navigator.vibrate(
                            visualStatus === 'success'
                                ? [100]
                                : visualStatus === 'warning'
                                    ? [160, 80, 160]
                                    : [250, 100, 250]
                        );
                    }

                    if (overlayTimer) {
                        window.clearTimeout(overlayTimer);
                    }

                    overlayTimer = window.setTimeout(
                        closeResultOverlay,
                        visualStatus === 'success' ? 2600 : 3600
                    );
                };

                const setStatus = (message, state = 'idle') => {
                    if (! statusElement) {
                        return;
                    }

                    statusElement.textContent = message;
                    statusElement.dataset.state = state;
                };

                const setControls = () => {
                    if (startButton) {
                        startButton.disabled = running;
                    }

                    if (stopButton) {
                        stopButton.disabled = ! running;
                    }

                    if (switchButton) {
                        switchButton.disabled =
                            ! running || cameras.length < 2;
                    }
                };

                const loadLibrary = () => {
                    if (window.Html5Qrcode) {
                        return Promise.resolve();
                    }

                    return new Promise((resolve, reject) => {
                        const existing = document.querySelector(
                            'script[data-elive-html5-qrcode]'
                        );

                        if (existing) {
                            existing.addEventListener('load', resolve, {
                                once: true,
                            });

                            existing.addEventListener('error', reject, {
                                once: true,
                            });

                            return;
                        }

                        const script = document.createElement('script');

                        script.src = libraryUrl;
                        script.async = true;
                        script.dataset.eliveHtml5Qrcode = 'true';
                        script.onload = resolve;
                        script.onerror = () => reject(
                            new Error(
                                'The camera scanner library could not be loaded.'
                            )
                        );

                        document.head.appendChild(script);
                    });
                };

                const stopScanner = async () => {
                    if (! scanner || ! running) {
                        running = false;
                        setControls();

                        return;
                    }

                    try {
                        await scanner.stop();
                    } catch (error) {
                        console.warn(
                            'Unable to stop QR scanner cleanly.',
                            error
                        );
                    }

                    try {
                        await scanner.clear();
                    } catch (error) {
                        console.warn(
                            'Unable to clear QR scanner cleanly.',
                            error
                        );
                    }

                    scanner = null;
                    running = false;
                    processing = false;

                    if (readerElement) {
                        readerElement.innerHTML = `
                            <div class="elive-camera-placeholder">
                                Start the camera to scan an attendee QR code.
                            </div>
                        `;
                    }

                    setStatus('Camera is stopped.');
                    setControls();
                };

                const handleDecodedText = async (decodedText) => {
                    const value = String(decodedText ?? '').trim();

                    if (! value || processing) {
                        return;
                    }

                    const now = Date.now();

                    if (
                        value === lastDecodedText
                        && now - lastDecodedAt < 4500
                    ) {
                        return;
                    }

                    lastDecodedText = value;
                    lastDecodedAt = now;
                    processing = true;

                    setStatus(
                        'QR code detected. Processing check-in...',
                        'success'
                    );

                    try {
                        $wire.set('scanValue', value);

                        await $wire.processScan();

                        const result = await $wire.get('lastResult');

                        showResultOverlay(result ?? {});

                        setStatus(
                            'Scan processed. Ready for the next attendee.',
                            result?.success
                                ? 'success'
                                : result?.status === 'already_checked_in'
                                    ? 'success'
                                    : 'error'
                        );
                    } catch (error) {
                        console.error(error);

                        setStatus(
                            error?.message
                                ?? 'The scanned QR code could not be processed.',
                            'error'
                        );
                    } finally {
                        window.setTimeout(() => {
                            processing = false;
                        }, 2400);
                    }
                };

                const startScanner = async (
                    preferredCameraId = null
                ) => {
                    if (running) {
                        return;
                    }

                    const eventId = await $wire.get('eventId');
                    const checkInPointId = await $wire.get(
                        'checkInPointId'
                    );

                    if (! eventId || ! checkInPointId) {
                        setStatus(
                            'Select an event and check-in point first.',
                            'error'
                        );

                        return;
                    }

                    setStatus('Requesting camera access...');

                    try {
                        await loadLibrary();

                        cameras = await window.Html5Qrcode.getCameras();

                        if (! cameras.length) {
                            throw new Error(
                                'No camera was found on this device.'
                            );
                        }

                        let cameraId = preferredCameraId;

                        if (! cameraId) {
                            const backCameraIndex = cameras.findIndex(
                                (camera) =>
                                    /back|rear|environment/i.test(
                                        camera.label
                                    )
                            );

                            cameraIndex =
                                backCameraIndex >= 0
                                    ? backCameraIndex
                                    : 0;

                            cameraId = cameras[cameraIndex].id;
                        } else {
                            const selectedIndex = cameras.findIndex(
                                (camera) =>
                                    camera.id === preferredCameraId
                            );

                            cameraIndex =
                                selectedIndex >= 0
                                    ? selectedIndex
                                    : 0;
                        }

                        if (readerElement) {
                            readerElement.innerHTML = '';
                        }

                        scanner = new window.Html5Qrcode(
                            'elive-qr-reader',
                            {
                                verbose: false,
                            }
                        );

                        await scanner.start(
                            cameraId,
                            {
                                fps: 12,
                                qrbox: (viewfinderWidth, viewfinderHeight) => {
                                    const size = Math.floor(
                                        Math.min(
                                            viewfinderWidth,
                                            viewfinderHeight
                                        ) * 0.72
                                    );

                                    return {
                                        width: Math.max(size, 180),
                                        height: Math.max(size, 180),
                                    };
                                },
                                aspectRatio: 1,
                            },
                            handleDecodedText,
                            () => {
                                // Decode failures are normal while searching
                                // for a QR code, so they are intentionally ignored.
                            }
                        );

                        running = true;

                        setStatus(
                            `Camera active: ${
                                cameras[cameraIndex]?.label
                                    || `Camera ${cameraIndex + 1}`
                            }`,
                            'success'
                        );

                        setControls();
                    } catch (error) {
                        console.error(error);

                        scanner = null;
                        running = false;

                        setStatus(
                            error?.message
                                ?? 'Camera access failed. Confirm camera permission and HTTPS.',
                            'error'
                        );

                        setControls();
                    }
                };

                const switchCamera = async () => {
                    if (cameras.length < 2) {
                        return;
                    }

                    cameraIndex =
                        (cameraIndex + 1) % cameras.length;

                    const nextCameraId =
                        cameras[cameraIndex].id;

                    await stopScanner();
                    await startScanner(nextCameraId);
                };

                startButton?.addEventListener(
                    'click',
                    () => startScanner()
                );

                stopButton?.addEventListener(
                    'click',
                    stopScanner
                );

                switchButton?.addEventListener(
                    'click',
                    switchCamera
                );

                window.addEventListener(
                    'beforeunload',
                    () => {
                        void stopScanner();
                    },
                    {
                        once: true,
                    }
                );

                document.addEventListener(
                    'livewire:navigating',
                    () => {
                        void stopScanner();
                    },
                    {
                        once: true,
                    }
                );

                overlayCloseButton?.addEventListener(
                    'click',
                    closeResultOverlay
                );

                overlayElement?.addEventListener(
                    'click',
                    (event) => {
                        if (event.target === overlayElement) {
                            closeResultOverlay();
                        }
                    }
                );

                document.addEventListener(
                    'keydown',
                    (event) => {
                        if (event.key === 'Escape') {
                            closeResultOverlay();
                        }
                    }
                );

                setControls();
            })();
        </script>
    @endscript

</x-filament-panels::page><x-filament-panels::page>
    @php
        $events = $this->getAvailableEvents();
        $checkInPoints = $this->getAvailableCheckInPoints();
        $searchResults = $this->getSearchResults();
        $selectedAttendee = $this->getSelectedAttendee();
        $recentCheckIns = $this->getRecentCheckIns();
        $counters = $this->getCounters();
        $categories = $this->getAvailableCategories();
        $badgeTypes = $this->getAvailableBadgeTypes();

        $resultStatus = $lastResult['status'] ?? null;
        $resultSuccess = (bool) ($lastResult['success'] ?? false);

        $resultClass = match ($resultStatus) {
            'checked_in',
            'onsite_registered' => 'elive-result-success',
            'already_checked_in' => 'elive-result-warning',
            'invalid_code',
            'attendee_not_found',
            'attendee_not_eligible',
            'access_denied',
            'check_in_failed' => 'elive-result-danger',
            default => 'elive-result-neutral',
        };
    @endphp

